# OpenAI 임베딩/LLM
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Upstage. 약관 파싱(document-digitization), 임베딩, 증권 분석(Studio Agent)이
# 같은 키를 쓴다. 도메인이 같고 제품만 다르다.
UPSTAGE_API_KEY=

# 증권 분석 에이전트. Upstage Studio에서 만든 파싱->분류->추출 파이프라인이다.
# 콘솔의 에이전트 상세에서 agt_로 시작하는 ID를 복사한다.
# 비어 있으면 증권 분석 경로가 꺼진다(약관 분석은 그대로 동작).
UPSTAGE_AGENT_ID=

# 에이전트 설정 버전. 비우면 최신을 쓴다.
# Studio에서 에이전트를 고치면 코드 변경 없이 결과가 바뀌므로,
# 평가 수치를 재현해야 할 때는 버전을 박는다.
UPSTAGE_AGENT_CONFIG_ID=

# pgvector 연결
DATABASE_URL=

# Spring Boot 콜백 대상 (미설정 시 콜백은 로그만 남기고 스킵됨)
SPRING_BASE_URL=

# Spring과 주고받는 내부 API 키. 미설정 시 인증 없이 요청을 처리한다.
INTERNAL_API_KEY=

# 답변 생성 벤더. 미설정 시 config.py의 기본값(openai-41)을 쓴다.
ANSWER_PROVIDER=

# 로그 레벨
LOG_LEVEL=INFO
